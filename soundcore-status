#!/usr/bin/env bash
# Usage: soundcore-status [--quick]
#
# Emits one JSON blob describing whichever openscq30-paired Soundcore device
# is currently connected over Bluetooth. A full read connects to the device
# and adds the settings openscq30 exposes for it (varies per model) and their
# current values; if that fails, "error" says why. --quick stops once the
# device is found, without connecting to it -- all the bar icon needs.
set -uo pipefail

quick=false
[ "${1:-}" = "--quick" ] && quick=true

# Bound every device call so a wedged Bluetooth connection can't hold the
# lock, and the panel's status process, forever.
call_timeout=${SOUNDCORE_CALL_TIMEOUT:-15}
lock_timeout=${SOUNDCORE_LOCK_TIMEOUT:-40}

paired_json=$(openscq30-cli paired-devices list --json 2>/dev/null)
[ -z "$paired_json" ] && paired_json='[]'

connected_raw=$(bluetoothctl devices Connected 2>/dev/null)

mac=""
name=""
model=""

while IFS= read -r line; do
  [ -z "$line" ] && continue
  cmac=$(awk '{print $2}' <<<"$line")
  cname=$(cut -d' ' -f3- <<<"$line")
  m=$(jq -r --arg mac "$cmac" '.[] | select(.macAddress | ascii_upcase == ($mac | ascii_upcase)) | .model' <<<"$paired_json" 2>/dev/null)
  if [ -n "$m" ] && [ "$m" != "null" ]; then
    mac="$cmac"
    name="$cname"
    model="$m"
    break
  fi
done <<<"$connected_raw"

if [ -z "$mac" ]; then
  echo '{"connected":false}'
  exit 0
fi

filtered_schema='[]'
values_map='{}'
error=""

emit() {
  jq -n \
    --arg mac "$mac" \
    --arg name "$name" \
    --arg model "$model" \
    --argjson detailed "$1" \
    --argjson schema "$filtered_schema" \
    --argjson values "$values_map" \
    --arg error "$error" \
    '{connected:true, detailed:$detailed, mac:$mac, name:$name, model:$model}
     + if $detailed then {schema:$schema, values:$values} else {} end
     + if $error != "" then {error:$error} else {} end'
}

if $quick; then
  emit false
  exit 0
fi

errfile=$(mktemp) || exit 1
trap 'rm -f "$errfile"' EXIT

# device_call <args...>: runs `openscq30-cli device` against $mac with its
# stdout in $out. On failure, records the first failure's reason in $error.
device_call() {
  local rc=0
  out=$(timeout "$call_timeout" openscq30-cli device --mac-address "$mac" "$@" 2>"$errfile") || rc=$?
  [ "$rc" -eq 0 ] && return 0
  if [ -z "$error" ]; then
    if [ "$rc" -eq 124 ]; then
      error="timed out talking to the headphones"
    else
      error=$(grep -v '^[[:space:]]*$' "$errfile" | tail -n 1 | sed 's/^Error: *//' | cut -c1-200)
      [ -n "$error" ] || error="openscq30-cli exited with status $rc"
    fi
  fi
  return "$rc"
}

# openscq30 allows one connection per device; serialize with soundcore-set.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/soundcore.lock"
if ! flock -w "$lock_timeout" 9; then
  error="timed out waiting for another Soundcore command to finish"
  emit true
  exit 0
fi

schema_json='[]'
device_call list-settings --json && schema_json=$out

filtered_schema=$(jq -c '[.[] | select(.categoryId=="soundModes" or .categoryId=="equalizer")]' <<<"$schema_json" 2>/dev/null)
[ -n "$filtered_schema" ] || filtered_schema='[]'

# The setting types the panel can show; keep in step with CONTROL_TYPES in
# Model.js.
ids=$(jq -r '
  [.[] | select(.categoryId=="soundModes" or .categoryId=="equalizer")
       | .settings[]
       | select(.type | IN("select", "optionalSelect", "modifiableSelect", "toggle", "i32Range", "equalizer"))
       | .settingId]
  + [.[] | select(.categoryId=="deviceInformation")
        | .settings[] | select(.settingId | test("battery"; "i"))
        | .settingId]
  | unique | .[]
' <<<"$schema_json" 2>/dev/null)

get_args=()
while IFS= read -r id; do
  [ -z "$id" ] && continue
  get_args+=(--get "$id")
done <<<"$ids"

if [ "${#get_args[@]}" -gt 0 ]; then
  # On a partial failure openscq30-cli still prints the values it did read.
  device_call setting "${get_args[@]}" --json
  values_map=$(jq -c '[.[] | {(.settingId): .value.value}] | add // {}' <<<"$out" 2>/dev/null)
  [ -n "$values_map" ] || values_map='{}'
fi

emit true
