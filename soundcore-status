#!/usr/bin/env bash
# Usage: soundcore-status [--quick]
#
# Emits one JSON blob describing whichever openscq30-paired Soundcore device
# is currently connected over Bluetooth. A full read connects to the device
# and adds the settings openscq30 exposes for it (varies per model) and their
# current values; if that fails, "error" says why. --quick stops once the
# device is found, without connecting to it -- all the bar icon needs.
#
# A connected Soundcore device that openscq30 doesn't know yet is registered
# with it (`openscq30-cli paired-devices add`) under the model its Bluetooth
# name matches. One that matches no model, or more than one, is left alone
# and reported as {"connected":false,"unrecognized":"<its name>"}. Without
# openscq30-cli, nothing can be done; that's {"connected":false,"missing":
# "openscq30-cli"}.
set -uo pipefail

if ! command -v openscq30-cli >/dev/null 2>&1; then
  echo '{"connected":false,"missing":"openscq30-cli"}'
  exit 0
fi

quick=false
[ "${1:-}" = "--quick" ] && quick=true

# Bound every device call so a wedged Bluetooth connection can't hold the
# lock, and the panel's status process, forever.
call_timeout=${SOUNDCORE_CALL_TIMEOUT:-15}
lock_timeout=${SOUNDCORE_LOCK_TIMEOUT:-40}

paired_json=$(openscq30-cli paired-devices list --json 2>/dev/null)
[ -z "$paired_json" ] && paired_json='[]'

connected_raw=$(bluetoothctl devices Connected 2>/dev/null)

models_json=""

# The openscq30 model whose name is `$1`, if exactly one is. A model may go
# by several names ("Soundcore Q30 / Life Q30"); case and spacing don't count.
model_for_name() {
  [ -n "$models_json" ] || models_json=$(openscq30-cli list-models --json 2>/dev/null)
  jq -r --arg name "$1" '
    def norm: ascii_downcase | gsub("\\s+"; " ") | ltrimstr(" ") | rtrimstr(" ");
    ($name | norm) as $n
    | [.[] | select(.name | split("/") | map(norm | if startswith("soundcore ") then . else "soundcore " + . end)
                    | any(. == $n))
           | .model]
    | unique
    | if length == 1 then .[0] else empty end
  ' <<<"$models_json" 2>/dev/null
}

# Registers connected device `$1` named `$2` with openscq30 if its name
# identifies the model, setting $registered to that model. Every openscq30
# model name starts with "Soundcore", so nothing else is looked up.
registered=""
unrecognized=""
register() {
  registered=""
  shopt -s nocasematch
  [[ $2 == soundcore* ]] || { shopt -u nocasematch; return 1; }
  shopt -u nocasematch
  [[ $1 =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || return 1
  local m
  m=$(model_for_name "$2")
  if [ -n "$m" ] && openscq30-cli paired-devices add --mac-address "$1" --model "$m" >/dev/null 2>&1; then
    registered=$m
    return 0
  fi
  [ -n "$unrecognized" ] || unrecognized=$(cut -c1-64 <<<"$2")
  return 1
}

mac=""
name=""
model=""
unpaired=()

while IFS= read -r line; do
  [ -z "$line" ] && continue
  cmac=$(awk '{print $2}' <<<"$line")
  cname=$(cut -d' ' -f3- <<<"$line")
  m=$(jq -r --arg mac "$cmac" '.[] | select(.macAddress | ascii_upcase == ($mac | ascii_upcase)) | .model' <<<"$paired_json" 2>/dev/null)
  if [ -n "$m" ] && [ "$m" != "null" ]; then
    mac="$cmac"
    name="$cname"
    model="$m"
    break
  fi
  unpaired+=("$line")
done <<<"$connected_raw"

# Only once no device openscq30 already knows is connected.
if [ -z "$mac" ]; then
  for line in "${unpaired[@]}"; do
    cmac=$(awk '{print $2}' <<<"$line")
    cname=$(cut -d' ' -f3- <<<"$line")
    if register "$cmac" "$cname"; then
      mac="$cmac"
      name="$cname"
      model="$registered"
      break
    fi
  done
fi

if [ -z "$mac" ]; then
  jq -cn --arg name "$unrecognized" '{connected:false} + if $name != "" then {unrecognized:$name} else {} end'
  exit 0
fi

filtered_schema='[]'
values_map='{}'
error=""
# This computer's Bluetooth address, so the panel can tell it apart from the
# other devices headphones with dual connections remember.
adapter=""

emit() {
  jq -n \
    --arg mac "$mac" \
    --arg name "$name" \
    --arg model "$model" \
    --argjson detailed "$1" \
    --argjson schema "$filtered_schema" \
    --argjson values "$values_map" \
    --arg error "$error" \
    --arg adapter "$adapter" \
    '{connected:true, detailed:$detailed, mac:$mac, name:$name, model:$model}
     + if $detailed then {schema:$schema, values:$values} else {} end
     + if $detailed and $adapter != "" then {adapter:$adapter} else {} end
     + if $error != "" then {error:$error} else {} end'
}

if $quick; then
  emit false
  exit 0
fi

adapter=$(bluetoothctl show 2>/dev/null | awk '/^Controller/ {print $2; exit}')

errfile=$(mktemp) || exit 1
trap 'rm -f "$errfile"' EXIT

# device_call <args...>: runs `openscq30-cli device` against $mac with its
# stdout in $out. On failure, records the first failure's reason in $error.
device_call() {
  local rc=0
  out=$(timeout "$call_timeout" openscq30-cli device --mac-address "$mac" "$@" 2>"$errfile") || rc=$?
  [ "$rc" -eq 0 ] && return 0
  if [ -z "$error" ]; then
    if [ "$rc" -eq 124 ]; then
      error="timed out talking to the headphones"
    else
      error=$(grep -v '^[[:space:]]*$' "$errfile" | tail -n 1 | sed 's/^Error: *//' | cut -c1-200)
      [ -n "$error" ] || error="openscq30-cli exited with status $rc"
    fi
  fi
  return "$rc"
}

# openscq30 allows one connection per device; serialize with soundcore-set.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/soundcore.lock"
if ! flock -w "$lock_timeout" 9; then
  error="timed out waiting for another Soundcore command to finish"
  emit true
  exit 0
fi

schema_json='[]'
device_call list-settings --json && schema_json=$out

# Every category but EQ import/export, which the panel has no use for.
filtered_schema=$(jq -c '[.[] | select(.categoryId != "equalizerImportExport")]' <<<"$schema_json" 2>/dev/null)
[ -n "$filtered_schema" ] || filtered_schema='[]'

# The values of the setting types the panel shows; keep in step with
# CONTROL_TYPES in Model.js. Actions have none.
ids=$(jq -r '
  [.[] | .settings[]
       | select(.type | IN("select", "optionalSelect", "modifiableSelect", "toggle", "i32Range", "equalizer",
                          "hueColorPicker", "multiSelectWithRemove", "information"))
       | .settingId]
  | unique | .[]
' <<<"$filtered_schema" 2>/dev/null)

get_args=()
while IFS= read -r id; do
  [ -z "$id" ] && continue
  get_args+=(--get "$id")
done <<<"$ids"

if [ "${#get_args[@]}" -gt 0 ]; then
  # On a partial failure openscq30-cli still prints the values it did read.
  device_call setting "${get_args[@]}" --json
  values_map=$(jq -c '[.[] | {(.settingId): .value.value}] | add // {}' <<<"$out" 2>/dev/null)
  [ -n "$values_map" ] || values_map='{}'
fi

emit true
