#!/usr/bin/env bash
# Stand-in for openscq30-cli used by tests/scripts.test.sh. It mimics the parts
# the plugin relies on: the JSON shapes of `paired-devices list`,
# `list-settings` and `setting --get`, exit status 1 with "Error: ..." on
# stderr, and -- the reason it exists -- openscq30's rule that only one
# connection to a device can be open at a time.
#
# State lives in $FAKE_SCQ_STATE: schema.json, values.json, calls.log, and
# fail-next (when present, the next device call fails with its contents).
set -uo pipefail

state=${FAKE_SCQ_STATE:?FAKE_SCQ_STATE must be set}
echo "$*" >>"$state/calls.log"

case "${1:-}" in
  paired-devices)
    echo '[{"macAddress":"AA:BB:CC:DD:EE:FF","model":"SoundcoreA3040"}]'
    exit 0
    ;;
  device) ;;
  *)
    echo "Error: unsupported command: $*" >&2
    exit 2
    ;;
esac

# device --mac-address <mac> <subcommand> [args...]
sub=$4
shift 4

if ! mkdir "$state/connection" 2>/dev/null; then
  echo "Error: connection: other: Bluetooth operation not permitted: UUID already registered" >&2
  exit 1
fi
trap 'rmdir "$state/connection"' EXIT

sleep "${FAKE_SCQ_DELAY:-0.5}"

if [ -f "$state/fail-next" ]; then
  cat "$state/fail-next" >&2
  rm -f "$state/fail-next"
  exit 1
fi

case "$sub" in
  list-settings)
    cat "$state/schema.json"
    ;;
  setting)
    gets=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --get) gets+=("$2"); shift 2 ;;
        --set)
          key=${2%%=*} value=${2#*=}
          jq --arg k "$key" --arg v "$value" '
            .[$k] = (if $k == "volumeAdjustments" then ($v | split(",") | map(tonumber))
                     elif $v == "" then null else $v end)
          ' "$state/values.json" >"$state/values.json.tmp" && mv "$state/values.json.tmp" "$state/values.json"
          shift 2
          ;;
        *) shift ;;
      esac
    done
    if [ "${#gets[@]}" -gt 0 ]; then
      jq --args '. as $v | [$ARGS.positional[] | {settingId: ., value: {type: "x", value: $v[.]}}]' \
        "${gets[@]}" <"$state/values.json"
    else
      echo OK
    fi
    ;;
esac
