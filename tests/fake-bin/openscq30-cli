#!/usr/bin/env bash
# Stand-in for openscq30-cli used by tests/scripts.test.sh. It mimics the parts
# the plugin relies on: the JSON shapes of `paired-devices list`,
# `list-settings` and `setting --get`, how `--set` values are parsed per
# setting type (including saving/deleting custom EQ profiles with +name and
# -name, and the \ escape for selecting one), commands running in the order
# given, exit status 1 with "Error: ..." on stderr, and -- the reason it
# exists -- openscq30's rule that only one connection to a device can be open
# at a time.
#
# State lives in $FAKE_SCQ_STATE: schema.json, values.json, paired.json,
# models.json (what `list-models --json` prints), calls.log, and fail-next
# (when present, the next device call fails with its contents).
set -uo pipefail

state=${FAKE_SCQ_STATE:?FAKE_SCQ_STATE must be set}
echo "$*" >>"$state/calls.log"

case "${1:-}" in
  paired-devices)
    case "${2:-}" in
      list) cat "$state/paired.json" ;;
      add)
        # paired-devices add --mac-address <mac> --model <model>; re-adding
        # a device replaces it, as openscq30 does.
        jq --arg mac "$4" --arg model "$6" \
          'map(select(.macAddress != $mac)) + [{macAddress: $mac, model: $model, isDemo: false}]' \
          "$state/paired.json" >"$state/paired.json.tmp" && mv "$state/paired.json.tmp" "$state/paired.json"
        echo Paired
        ;;
    esac
    exit 0
    ;;
  list-models)
    cat "$state/models.json"
    exit 0
    ;;
  device) ;;
  *)
    echo "Error: unsupported command: $*" >&2
    exit 2
    ;;
esac

# device --mac-address <mac> <subcommand> [args...]
sub=$4
shift 4

if ! mkdir "$state/connection" 2>/dev/null; then
  echo "Error: connection: other: Bluetooth operation not permitted: UUID already registered" >&2
  exit 1
fi
trap 'rmdir "$state/connection"' EXIT

sleep "${FAKE_SCQ_DELAY:-0.5}"

if [ -f "$state/fail-next" ]; then
  cat "$state/fail-next" >&2
  rm -f "$state/fail-next"
  exit 1
fi

apply_set() {
  local key=${1%%=*} raw=${1#*=}
  jq --arg k "$key" --arg v "$raw" --slurpfile schema "$state/schema.json" '
    ($schema[0] | [.[].settings[]] | map(select(.settingId == $k)) | first) as $s
    | if $s == null then error("\($k) is not a setting of this device")
      elif $s.type == "equalizer" then .[$k] = ($v | split(",") | map(tonumber))
      elif $s.type == "toggle" then .[$k] = ($v | if . == "true" then true elif . == "false" then false
                                                  else error("provided string was not `true` or `false`") end)
      elif $s.type == "i32Range" then .[$k] = ($v | tonumber)
      elif $s.type == "optionalSelect" and $v == "" then .[$k] = null
      elif $s.type == "modifiableSelect" and ($v | startswith("+")) then .
      elif $s.type == "modifiableSelect" and ($v | startswith("-")) then
        if .[$k] == $v[1:] then .[$k] = null else . end
      else ($v | ltrimstr("\\")) as $name
        | if ($s.setting.options | index($name)) == null
          then error("\($k): \($name) is not a valid option")
          else .[$k] = $name end
      end
  ' "$state/values.json" >"$state/values.json.tmp" 2>"$state/jq.err" || {
    sed 's/^jq: error[^:]*: /Error: /' "$state/jq.err" >&2
    return 1
  }
  mv "$state/values.json.tmp" "$state/values.json"

  # Saving or deleting a custom profile changes the options openscq30 lists.
  case "$raw" in
    +*|-*)
      jq --arg k "$key" --arg name "${raw:1}" --arg op "${raw:0:1}" '
        map(.settings |= map(if .settingId == $k and .type == "modifiableSelect"
          then .setting.options = (if $op == "+" then (.setting.options - [$name]) + [$name]
                                   else .setting.options - [$name] end)
               | .setting.localizedOptions = .setting.options
          else . end))
      ' "$state/schema.json" >"$state/schema.json.tmp" && mv "$state/schema.json.tmp" "$state/schema.json"
      ;;
  esac
}

case "$sub" in
  list-settings)
    cat "$state/schema.json"
    ;;
  setting)
    gets=()
    json=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --get) gets+=("$2"); shift 2 ;;
        --set) apply_set "$2" || exit 1; shift 2 ;;
        --json) json=true; shift ;;
        *) shift ;;
      esac
    done
    if $json; then
      jq --args '. as $v | [$ARGS.positional[] | {settingId: ., value: {type: "x", value: $v[.]}}]' \
        "${gets[@]}" <"$state/values.json"
    elif [ "${#gets[@]}" -eq 0 ]; then
      echo OK
    fi
    ;;
esac
